// yusung-harness-doc - local document management schema
// Domain source: docs/architecture/ARCHITECTURE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum RepoType {
  LOCAL
  REMOTE
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Project {
  id                Int                 @id @default(autoincrement())
  title             String
  description       String
  repoPaths         ProjectRepository[]
  plans             Plan[]
  tasks             Task[]
  domains           Domain[]
  wireframes        Wireframe[]
  architectures     Architecture[]
  architecturePlans ArchitecturePlan[]
  drafts            Draft[]
  assets            Asset[]
  designs           Design[]
  reviews           Review[]
  requests          Request[]
  workLogs          WorkLog[]
}

model ProjectRepository {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  repoType  RepoType

  @@unique([path, repoType])
  @@index([projectId])
}

model Plan {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  content   String
  title     String
  tasks     Task[]

  @@unique([projectId, version])
  @@index([projectId])
}

model Asset {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  designs   Design[]
  html      String
  title     String

  @@index([projectId])
}

model Design {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wireframeId Int
  wireframe   Wireframe @relation(fields: [wireframeId], references: [id])
  assetId     Int
  asset       Asset     @relation(fields: [assetId], references: [id])
  html        String
  title       String
  version     Int       @default(1)

  @@unique([wireframeId, assetId, version])
  @@index([projectId])
  @@index([assetId])
  @@index([wireframeId])
}

//실제 구현된 아키텍쳐 기준
model Architecture {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}

// 구현 전 아키텍처 설계 계획을 HTML 구조도로 저장한다.
model ArchitecturePlan {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}

// 프로젝트에 요청된 작업과 진행 상태를 저장한다.
model Request {
  id        Int           @id @default(autoincrement())
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  title     String
  content   String
  status    RequestStatus @default(PENDING)

  @@index([projectId])
}

// 프로젝트에서 수행한 작업 내역을 저장한다.
model WorkLog {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}

//해당 프로젝트의 도메인 구조
model Domain {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}

model Task {
  id        Int        @id @default(autoincrement())
  projectId Int
  project   Project    @relation(fields: [projectId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  planId    Int
  plan      Plan       @relation(fields: [planId], references: [id])
  status    TaskStatus @default(PENDING)
  title     String
  content   String?

  @@index([projectId])
  @@index([planId])
}

model Draft {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}

model Wireframe {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  designs   Design[]
  title     String
  html      String
  page      String      @default(cuid())
  index     String
  parentId  Int?
  parent    Wireframe?  @relation("WireframeHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  Wireframe[] @relation("WireframeHierarchy")
  version   Int         @default(1)

  @@unique([projectId, page, version])
  @@index([projectId, index])
  @@index([parentId])
}

model Review {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String

  @@index([projectId])
}
